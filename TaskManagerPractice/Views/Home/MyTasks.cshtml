@{
    ViewData["Title"] = "MyTasks";
}

@model List<TaskManagerPractice.Models.TaskItem>


<div class="text-center">
    <h1 class="display-4">My Tasks</h1>

    <div class="btn-group mb-3" role="group">
        <a asp-action="MyTasks" asp-route-SortBy="ByOrder" class="btn btn-outline-primary">Sort By Order of Creation</a>
        <a asp-action="MyTasks" asp-route-SortBy="ByDueDate" class="btn btn-outline-primary">Sort By Due Date</a>
        <a asp-action="MyTasks" asp-route-SortBy="ByComplition" class="btn btn-outline-primary">Sort By Status</a>
        <a asp-action="MyTasks" asp-route-SortBy="ByName" class="btn btn-outline-primary">Sort By Name</a>
    </div>

    <table class="table">
        <thead>
            <tr>
                <th>Task</th>
                <th>Description</th>
                <th>Deadline</th>
                <th>completed</th>
            </tr>
        </thead>
        <tbody>

            @foreach (var task in Model)
        {
            <tr>
                <td>@task.TaskName</td>
                <td>@task.TaskDescription</td>
                <td>@task.DeadlineDate.ToShortDateString()</td>
                <td>
                        
                    <form asp-action="ChangeTaskComplitionStatus" method="post">
                            <input type="hidden" name="Id" value="@task.Id" />
                            <button type="submit" class="btn btn-primary">@task.WasCompleted</button>

                    </form>
                </td>
                <td>
                    <form asp-action="DeleteTask" method="post">
                        <input type="hidden" name="Id" value="@task.Id" />
                        <button type="submit" class="btn btn-primary">Delete task</button>
                    </form>
                </td>
                
            </tr>
            
            }
        </tbody>
    </table>
    <a asp-action="ClearAllTasks" class="btn btn-secondary">ClearAllTasks</a>
    <a asp-action="CreateNewTask" class="btn btn-secondary">New Task</a>
</div>

