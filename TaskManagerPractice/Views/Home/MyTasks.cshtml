@{
    ViewData["Title"] = "MyTasks";
}

@model List<TaskManagerPractice.Models.TaskItem>


<div class="text-center">
    <h1 class="display-4">My Tasks</h1>
    <table class="table">
        <thead>
            <tr>
                <th>Task</th>
                <th>Description</th>
                <th>Deadline</th>
                <th>completed</th>
            </tr>
        </thead>
        <tbody>

            @foreach (var task in Model)
        {
            <tr>
                <td>@task.TaskName</td>
                <td>@task.TaskDescription</td>
                <td>@task.DeadlineDate.ToShortDateString()</td>
                <td>(@task.WasCompleted?"Yes":"No")</td>
            </tr>
            }
        </tbody>
    </table>
    <a asp-action="CreateNewTask" class="btn-dark">New Task</a>
</div>

