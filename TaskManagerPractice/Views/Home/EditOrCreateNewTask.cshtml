@{
    ViewData["Title"] = "Create Task";
}

@model TaskItem



<div class="text-center">
    <h1 class="display-4">Edit Or Create new task</h1>




    
    <form asp-action="CreateNewTaskFormSubmit" method="post">
        <div>
            
        <input hidden asp-for="Id" />
        <label>Task Name</label>
        <input  asp-for="TaskName" class=" form-text" placeholder="Task Name">
        </div>

        <div>
        <label>Task Description</label>
        <textarea asp-for="TaskDescription" class="form-text" placeholder="Task Description..."></textarea>
        </div>

        <div>
        <label>Date for Complition</label>
        <input asp-for="DeadlineDate" type ="date" />
        </div>
        
        <button type="submit" class=" btn btn-secondary">@(Model.Id==0?"Create New Task":"Update Task") </button>
       
    </form>
</div>
